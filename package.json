{
  "name": "chainwill",
  "version": "1.0.0",
  "private": true,
  "description": "ChainWill — decentralized digital will & inheritance DApp (Ganache edition)",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/run.mjs dev",
    "start": "node scripts/run.mjs start",
    "chain": "npm --prefix blockchain run ganache",
    "deploy": "npm --prefix blockchain run deploy",
    "build": "npm --prefix frontend run build",
    "reset": "node scripts/reset.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "demo:auto": "node scripts/demo-auto.mjs",
    "test": "npm --prefix blockchain test && npm --prefix backend test && npm --prefix frontend test",
    "test:contracts": "npm --prefix blockchain test",
    "test:backend": "npm --prefix backend test",
    "test:frontend": "npm --prefix frontend test",
    "test:e2e": "npm --prefix backend run test:e2e",
    "demo:tamper": "node backend/scripts/tamper.js",
    "demo:restore": "node backend/scripts/tamper.js --restore"
  },
  "engines": {
    "node": ">=18.17"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1"
  }
}
