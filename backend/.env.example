# ChainWill backend configuration.
# `npm run setup` (project root) generates a real .env with fresh secrets —
# you only need this file if you prefer to fill things in by hand.

PORT=4000

# --- secrets -----------------------------------------------------------------
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# 32 bytes, hex. Encrypts demo-wallet private keys and document keys at rest.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_ENCRYPTION_KEY=

# --- web push (npx web-push generate-vapid-keys) --------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT=mailto:admin@chainwill.local

# --- blockchain ----------------------------------------------------------------
GANACHE_RPC_URL=http://127.0.0.1:7545
GANACHE_MNEMONIC="myth like bonus scare over problem client lizard pioneer submit female collect"
# Optional: override the WillManager address from deployments/ganache.json
CHAINWILL_CONTRACT_ADDRESS=

# --- storage -------------------------------------------------------------------
DB_FILE=data/chainwill.db
# local = encrypted files in backend/secure-storage (Option A)
# ipfs  = local Kubo daemon via its HTTP API (Option B)
STORAGE_DRIVER=local
IPFS_API_URL=http://127.0.0.1:5001
MAX_UPLOAD_MB=10

# --- admin (read-only transparency dashboard) -------------------------------------
ADMIN_EMAIL=admin@chainwill.local
ADMIN_PASSWORD=

# --- demo conveniences -------------------------------------------------------------
# Allows the admin to fast-forward the local chain clock. Keep false on anything real.
ENABLE_DEMO_TOOLS=true

# --- optional e-mail fallback (leave SMTP_HOST empty to disable) --------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ChainWill <no-reply@chainwill.local>"
